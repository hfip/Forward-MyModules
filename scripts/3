const TMDB_LANG = "ar-SA";

// === دالات نتفليكس الجديدة والمصلحة بالكامل بناءً على روابطك وصورك ===
async function getNetflixMovies(page) { 
  // جلب الأفلام الحصرية من رقم القائمة الرسمية لنتفليكس الموضحة بالصورة
  return await fetchData("list/7057042", { page: page }, "movie"); 
}

async function getNetflixShows(page) { 
  // جلب المسلسلات الحصرية باستخدام رقم الشبكة الرسمي لنتفليكس (Network ID: 213)
  return await fetchData("discover/tv", { sort_by: "popularity.desc", with_networks: "213", page: page }, "tv"); 
}

// === دالات باقي المنصات (متروكة كما هي دون تعديل بناءً على طلبك) ===
async function getAppleMovies(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_watch_providers: "350", watch_region: "SA", page: page }, "movie"); }
async function getDisneyMovies(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_watch_providers: "337", watch_region: "SA", page: page }, "movie"); }
async function getAmazonMovies(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_watch_providers: "9", watch_region: "SA", page: page }, "movie"); }
async function getMaxMovies(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_watch_providers: "1899", watch_region: "SA", page: page }, "movie"); }
async function getAppleShows(page) { return await fetchData("discover/tv", { sort_by: "popularity.desc", with_watch_providers: "350", watch_region: "SA", page: page }, "tv"); }
async function getDisneyShows(page) { return await fetchData("discover/tv", { sort_by: "popularity.desc", with_watch_providers: "337", watch_region: "SA", page: page }, "tv"); }

// === دالات الاستوديوهات (متروكة كما هي لأنها ممتازة وشغالة بنجاح) ===
async function getPixar(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "3", page: page }, "movie"); }
async function getDreamworks(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "521", page: page }, "movie"); }
async function getMarvel(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "420", page: page }, "movie"); }
async function getWarnerBros(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "174", page: page }, "movie"); }
async function getSonyColumbia(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "5", page: page }, "movie"); }
async function getUniversal(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "33", page: page }, "movie"); }
async function getParamount(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "4", page: page }, "movie"); }
async function getA24(page) { return await fetchData("discover/movie", { sort_by: "popularity.desc", with_companies: "41077", page: page }, "movie"); }

// === دالة جلب الميتاداتا ومعالجتها بالمنطق المتوافق والمستقر ===
async function fetchData(api, params, forceMediaType) {
  params.language = TMDB_LANG;
  if (params.page && typeof params.page === 'object') {
    params.page = params.page.page || 1;
  }
  try {
    const response = await Widget.tmdb.get(api, { params: params });
    if (!response || !response.results) return [];
    return response.results.map((item) => {
      let mediaType = item.media_type || forceMediaType;
      if (!mediaType || mediaType === "mixed") mediaType = item.title ? "movie" : "tv";
      const rawDate = item.release_date ?? item.first_air_date;
      return {
        id: String(item.id),
        tmdbId: item.id,
        ids: { tmdb: item.id }, 
        type: "tmdb", 
        title: item.title ?? item.name,
        description: `قصة العمل:\n${item.overview || "لا يوجد وصف متاح حالياً."}`,
        releaseDate: rawDate, 
        backdropPath: item.backdrop_path, 
        posterPath: item.poster_path,
        rating: item.vote_average ? item.vote_average.toFixed(1) : "N/A", 
        mediaType: mediaType
      };
    });
  } catch (error) { return []; }
}
